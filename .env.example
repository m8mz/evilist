# Copy to .env for local development. Never commit real values.

# SendGrid API key for the contact form (server-only secret)
SENDGRID_API_KEY=

# Signs the contact form time-trap token (any long random string)
FORM_SECRET=

# true = log contact submissions instead of sending email (local/e2e)
CONTACT_DRY_RUN=false

# Public Discord invite shown in the footer/CTA (hidden when empty)
PUBLIC_DISCORD_INVITE_URL=https://discord.gg/XKQ26mjqN
