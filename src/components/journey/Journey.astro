---
// Scroll-driven career journey (spec §7; vector journey spec). A tall track with a pinned,
// full-width stage: as the visitor scrolls, the stage advances through the seven ranks and the
// vector scene (public/journey/scene.svg) ranks the character up with it. Until the scene loads,
// and if it never does, the inline silhouette holds the stage. scripts/journey.ts maps scroll
// progress to the active rank and the scene's state; CSS switches the cards and runs the idle
// life on the scene's inner groups.
//
// Accessibility and fallbacks: this animated version is decorative (aria-hidden). JourneyTimeline
// carries the same content, with each rank's still, for screen readers, and is what everyone sees
// without scripting or with reduced motion.
//
// It goes in the Section's `bleed` slot, so the stage spans the band's full width; the skip link
// and the timeline keep the content column.
import silhouette from "./silhouette.svg?raw";
import JourneyTimeline from "./JourneyTimeline.astro";
import Panel from "../ui/Panel.astro";
import RankChip from "../ui/RankChip.astro";
import Tag from "../ui/Tag.astro";
import { career, formatRange } from "../../data/career";

/** Each card lists at most this many highlights (only the first below 60rem). */
const CARD_HIGHLIGHTS = 3;
---

<div class="wrap">
  <a href="#skills" class="journey-skip">
    Skip the career journey
  </a>
</div>

<div class="journey" data-journey data-activity={career[0].activity} aria-hidden="true">
  <div class="journey__stage">
    <ol class="journey__rail">
      {career.map((stage, i) => (
        <li class:list={["journey__node", { "is-reached is-current": i === 0 }]} data-node>
          <RankChip rank={stage.rankLabel} size="sm" />
        </li>
      ))}
      <li class="journey__track-line" role="presentation">
        <span class="journey__fill"></span>
      </li>
    </ol>

    <div class="journey__media">
      <div class="journey__scene" data-scene set:html={silhouette} />
    </div>

    <div class="journey__cards">
      {career.map((stage, i) => (
        <Panel
          variant="case"
          class:list={["journey__card", { "is-active": i === 0 }]}
          data-card
          data-activity={stage.activity}
        >
          <div class="journey__card-head">
            <RankChip rank={stage.rankLabel} size="md" />
            <Tag>{formatRange(stage.start, stage.end)}</Tag>
          </div>
          <h3>{stage.shortTitle ?? stage.title}</h3>
          <p class="journey__meta">{stage.org}</p>
          <p>{stage.summary}</p>
          <ul class="journey__highlights" role="list">
            {stage.highlights.slice(0, CARD_HIGHLIGHTS).map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </Panel>
      ))}
    </div>
  </div>
</div>

<div class="wrap journey-fallback">
  <JourneyTimeline />
</div>

<script>
  import { initJourney } from "../../scripts/journey";
  initJourney();
</script>

<style>
  /* ---------- Which version shows ---------- */
  .journey,
  .journey-skip {
    display: none;
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .journey {
      display: block;
    }

    .journey-skip {
      display: inline-block;
    }

    /* Keep the timeline for screen readers and search, but not on screen. */
    .journey-fallback {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Its stills would load behind the hidden timeline; the stage shows the art instead. */
    .journey-fallback :global(.timeline__still) {
      display: none;
    }
  }

  /* Visually hidden until focused (keyboard users). */
  .journey-skip {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    padding: 0;
    background: var(--color-ember);
    color: var(--color-void); /* paper on ember is 3.3:1 */
    font-weight: 700;
    text-decoration: none;
  }

  .journey-skip:focus-visible {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    padding: 0.5rem 1rem;
    margin-top: 1rem;
  }

  /* ---------- Track and pinned stage ---------- */
  .journey {
    --stages: 7;
    --header: var(--header-h);
    position: relative;
    height: calc(var(--stages) * 62dvh + 100dvh - var(--header));
    margin-top: 2rem;
  }

  /* Below 60rem: rail, clip, card in rows; the clip takes what the card leaves. */
  .journey__stage {
    position: sticky;
    top: var(--header);
    height: calc(100dvh - var(--header));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 1rem;
    padding-block: 1rem 1.5rem;
  }

  /* ---------- Progress rail ---------- */
  .journey__rail {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .journey__node {
    position: relative;
    z-index: 1;
    transition: transform 240ms ease-out;
  }

  .journey__node.is-current {
    transform: scale(1.12);
  }

  /* Not reached yet: dimmed by colour, not opacity, so the chip text still passes 4.5:1. */
  .journey__node:not(.is-reached) :global(.rank-chip) {
    border-color: var(--color-iron);
    background: var(--color-graphite);
    color: var(--color-ash);
  }

  /* Seven chips must fit a 390 px phone. */
  @media (max-width: 39.99rem) {
    .journey__node :global(.rank-chip) {
      padding-inline: 0.25rem;
    }
  }

  .journey__track-line {
    position: absolute;
    inset: 50% calc(var(--gutter) + 1rem) auto;
    height: 1px;
    background: var(--color-slate);
  }

  .journey__fill {
    position: absolute;
    inset: 0;
    background: var(--color-ember);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
  }

  /* ---------- Scene ---------- */
  .journey__media {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: var(--color-carbon);
  }

  .journey__scene {
    position: absolute;
    inset: 0;
  }

  .journey__scene :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Idle life (vector journey spec §3.3): CSS on the inner groups; the scroll writes transforms */
  /* on the outer ones, so the two never fight. fill-box keeps each origin on the group itself. */
  .journey__scene :global(#part-torso-idle) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: breathe 4s ease-in-out infinite;
  }

  .journey__scene :global(#part-head-idle) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: sway 5s ease-in-out infinite;
  }

  .journey__scene :global(.glow) {
    animation: glow 2.4s ease-in-out infinite alternate;
  }

  @keyframes breathe {
    50% {
      transform: scaleY(1.01);
    }
  }

  @keyframes sway {
    25% {
      transform: rotate(-1.5deg);
    }

    75% {
      transform: rotate(1.5deg);
    }
  }

  @keyframes glow {
    to {
      opacity: 0.55;
    }
  }

  /* ---------- Cards ---------- */
  .journey__cards {
    display: grid;
    padding-inline: var(--gutter);
  }

  /* All cards share one grid cell, so the area is as tall as the tallest card and switching ranks never shifts the layout. */
  .journey__cards :global(.journey__card) {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    visibility: hidden;
    opacity: 0;
  }

  .journey__cards :global(.journey__card.is-active) {
    visibility: visible;
    opacity: 1;
    animation: card-in 320ms ease-out both;
  }

  .journey__card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .journey__cards h3 {
    margin-top: 0.25rem;
    font-size: var(--text-heading-lg);
  }

  .journey__meta {
    color: var(--color-ash);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  .journey__highlights {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding-left: 1.2rem;
    list-style: "- ";
    color: var(--color-fog);
  }

  .journey__highlights li::marker {
    color: var(--color-ash);
  }

  /* Below 60rem the card sits under the clip: one highlight keeps it whole on a phone. */
  @media (max-width: 59.99rem) {
    .journey__highlights li + li {
      display: none;
    }
  }

  /* Phones: smaller text so the active card fits under the pinned clip. Tablets keep 15px. */
  @media (max-width: 47.99rem) {
    .journey__cards p:not(.journey__meta),
    .journey__highlights {
      font-size: var(--text-caption);
    }
  }

  /* From 60rem the scene fills the stage; the rail runs across the top and the card sits left. Last, so it overrides the rules above. */
  @media (min-width: 60rem) {
    .journey {
      height: calc(var(--stages) * 70dvh + 100dvh - var(--header));
    }

    .journey__stage {
      display: block;
      padding: 0;
    }

    .journey__media {
      position: absolute;
      inset: 0;
    }

    /* The rail runs over the top of the stage, so the scene starts below it: the figure lands at about 80% of the stage's height. */
    .journey__scene {
      inset: 4.5rem 0 1rem;
    }

    .journey__rail {
      position: absolute;
      inset: 1.5rem 0 auto;
      z-index: 1;
    }

    .journey__cards {
      position: absolute;
      inset: 5rem auto 2.5rem var(--gutter);
      z-index: 1;
      width: min(30rem, 40vw);
      padding: 0;
    }

    .journey__cards :global(.journey__card) {
      align-self: center;
    }
  }

  /* Short desktop screens: one highlight and tighter insets keep the card inside the pinned stage. */
  @media (min-width: 60rem) and (max-height: 44rem) {
    .journey__cards {
      inset-block: 4.5rem 1.5rem;
    }

    .journey__highlights li + li {
      display: none;
    }
  }

  /* Very short desktop screens: the summary alone. */
  @media (min-width: 60rem) and (max-height: 34rem) {
    .journey__highlights {
      display: none;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
