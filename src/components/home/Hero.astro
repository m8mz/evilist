---
// Hero (spec §4): a full-bleed split terminal. The left pane runs the site's htop behind the copy,
// dimmed; the right pane draws the stack as a network behind the portrait; a 1px iron rule divides
// them in the grid gap, like a tmux split. Copy: prompt, name, rotating title, location, pitch and
// two actions. scripts/hero.ts wires the live parts.
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import Prompt from "../ui/Prompt.astro";
import RankChip from "../ui/RankChip.astro";
import TerminalFrame from "../ui/TerminalFrame.astro";
import HtopScreen from "./HtopScreen.astro";
import StackNetwork from "./StackNetwork.astro";
import authorPic from "../../images/author-pic.webp";
import { heroPitch, site } from "../../data/site";
import { decadePhrase, yearsOfExperience } from "../../data/career";

// Split so the surname stays on one line: "Marcus" / "Hancock-Gaillard", never "Hancock-" / "Gaillard".
const [firstName, ...rest] = site.name.split(" ");
const surname = rest.join(" ");
const pitch = heroPitch(decadePhrase(yearsOfExperience()));
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <div class="hero__pane hero__pane--term" aria-hidden="true">
        <HtopScreen class="hero__htop" />
      </div>
      <div class="hero__text">
        <Prompt path="marcus" cursor />
        <h1 id="hero-title" class="hero__name">
          {firstName} <span class="hero__surname">{surname}</span>
        </h1>
        <p class="hero__title">
          <span class="visually-hidden">{site.role}</span>
          <span
            class="hero__title-text"
            aria-hidden="true"
            data-title-rotator
            data-titles={JSON.stringify(site.titles)}
          >
            {site.titles[0]}
          </span>
        </p>
        <p class="hero__location">{site.location}</p>
        <p class="hero__pitch">{pitch}</p>
        <div class="hero__actions">
          <Button href="#journey">See the journey</Button>
          <Button href="/resume" variant="ghost">
            Read the resume
          </Button>
        </div>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__pane hero__pane--net" aria-hidden="true">
        <StackNetwork />
      </div>
      <figure class="hero__portrait" data-tilt>
        <TerminalFrame title="marcus@evilist:~">
          <RankChip slot="aside" rank="S" size="sm" label="S-rank: Sr. Systems Architect" />
          <Image
            src={authorPic}
            alt={`Portrait of ${site.name}`}
            widths={[320, 480, 720]}
            sizes="(min-width: 60rem) 26rem, 90vw"
            loading="eager"
            fetchpriority="high"
            class="hero__photo"
          />
        </TerminalFrame>
      </figure>
    </div>
  </div>
</section>

<script>
  import { initHero } from "../../scripts/hero";
  initHero();
</script>

<style>
  .hero {
    --hero-pt: clamp(3rem, 2rem + 6vw, 7rem);
    --hero-pb: var(--section-y);
    --hero-gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    /* From the content column's edge to the viewport's edge (.wrap is max 72rem + gutters). */
    --hero-edge: calc((100vw - min(72rem, 100vw)) / 2 + var(--gutter));
    /* Tuned in the browser. At 0.14 the htop's fog text lands on graphite (#191919): one surface
       step above void, so it reads as texture and never competes with the copy. */
    --hero-backdrop-opacity: 0.14;
    position: relative;
    overflow: hidden;
    padding-block: var(--hero-pt) var(--hero-pb);
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--hero-gap);
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .hero__copy,
  .hero__visual {
    position: relative;
    display: grid;
    align-content: center;
  }

  .hero__visual {
    justify-items: center;
    perspective: 900px;
  }

  /* ---------- Panes: behind everything, out to the viewport edges ---------- */
  .hero__pane {
    position: absolute;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Stacked: the terminal behind the copy, the network behind the portrait, and a horizontal
     rule in the middle of the gap between them. */
  .hero__pane--term {
    inset: calc(-1 * var(--hero-pt)) calc(-1 * var(--hero-edge)) calc(-0.5 * var(--hero-gap));
    opacity: var(--hero-backdrop-opacity);
  }

  .hero__pane--net {
    inset: calc(-0.5 * var(--hero-gap)) calc(-1 * var(--hero-edge)) calc(-1 * var(--hero-pb));
    border-top: 1px solid var(--color-iron);
  }

  /* Side by side: the divider runs down the middle of the grid gap. */
  @media (min-width: 60rem) {
    .hero__pane--term {
      inset: calc(-1 * var(--hero-pt)) calc(-0.5 * var(--hero-gap)) calc(-1 * var(--hero-pb))
        calc(-1 * var(--hero-edge));
    }

    .hero__pane--net {
      inset: calc(-1 * var(--hero-pt)) calc(-1 * var(--hero-edge)) calc(-1 * var(--hero-pb))
        calc(-0.5 * var(--hero-gap));
      border-top: 0;
      border-left: 1px solid var(--color-iron);
    }
  }

  .hero__pane--term :global(.hero__htop) {
    position: relative;
    height: 100%;
    padding: 1rem var(--gutter) 1.25rem;
    font-size: 13px;
  }

  /* htop keeps its F-key bar on the bottom row, whatever the pane's height. */
  .hero__pane--term :global(.hero__htop .htop__keys) {
    position: absolute;
    inset: auto var(--gutter) 0;
    margin: 0;
    padding-block: 0.25rem 1rem;
    background: var(--color-void);
  }

  /* ---------- Copy and portrait sit above the panes ---------- */
  .hero__text,
  .hero__portrait {
    position: relative;
    z-index: 1;
  }

  /* The copy column is a container, so the name and the longest title always fit it. */
  .hero__text {
    container-type: inline-size;
  }

  .hero__name {
    margin-top: 1rem;
    /* 16 characters of "Hancock-Gaillard" are 9.6em in JetBrains Mono. */
    font-size: min(var(--text-hero), 100cqi / 9.8);
    line-height: 1.1;
    max-width: 16ch;
  }

  .hero__surname {
    white-space: nowrap;
  }

  .hero__title {
    margin-top: 0.75rem;
    /* 25 characters ("Forward Deployed Engineer") are 15em. */
    font-size: min(clamp(1.375rem, 1rem + 1.6vw, 2.25rem), 100cqi / 15.4);
    line-height: 1.3;
    height: 1.3em;
    color: var(--color-paper);
    white-space: nowrap;
  }

  .hero__title-text {
    display: inline-block;
  }

  /* Only with scripting and motion allowed: the global reduced-motion rule would otherwise run
       this once and leave the title on its last keyframe, invisible. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .hero__title-text {
      animation: hero-title-cycle 4s ease-in-out infinite;
    }
  }

  @keyframes hero-title-cycle {
    0% {
      opacity: 0;
      transform: translateY(1rem);
    }
    10%,
    90% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(-1rem);
    }
  }

  .hero__location {
    margin-top: 0.5rem;
    color: var(--color-fog);
  }

  .hero__pitch {
    margin-top: 1.5rem;
    max-width: 34rem;
    color: var(--color-fog);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__portrait {
    width: min(26rem, 100%);
    margin: 0;
    transform-style: preserve-3d;
  }

  .hero__portrait :global(.term) {
    position: relative;
  }

  .hero :global(.hero__photo) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.85);
  }
</style>
