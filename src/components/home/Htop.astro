---
// The framed htop (spec §4.2): TerminalFrame + HtopScreen + the caption that says it is simulated.
// Only the social card renders it now; the home page's hero uses HtopScreen bare.
import TerminalFrame from "../ui/TerminalFrame.astro";
import HtopScreen from "./HtopScreen.astro";
import type { HtopSnapshot } from "../../data/htop";

interface Props {
  snapshot?: HtopSnapshot;
}

const { snapshot } = Astro.props;
---

<figure class="htop">
  <TerminalFrame title="htop · evilist">
    <HtopScreen snapshot={snapshot} />
  </TerminalFrame>
  <figcaption class="htop__caption">
    A simulated htop of the stack behind this site: Linux, Podman, HAProxy and Node.
  </figcaption>
</figure>

<script>
  import { initHtop } from "../../scripts/htop";
  initHtop();
</script>

<style>
  .htop {
    margin: 0;
  }

  .htop__caption {
    margin-top: 0.75rem;
    color: var(--color-ash);
    font-size: var(--text-caption);
  }
</style>
