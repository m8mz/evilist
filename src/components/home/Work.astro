---
// Case studies laid out like a manga page: one wide establishing panel, then two side by side.
import Panel from "../ui/Panel.astro";
import { sharedRepos, work } from "../../data/work";
---

<div class="work">
  {work.map((item, i) => (
    <Panel class:list={["work__panel", { "work__panel--wide": i === 0 }]}>
      <h3 class="work__title">{item.title}</h3>
      <p class="work__summary">{item.summary}</p>
      <p class="work__outcome">{item.outcome}</p>
      <p class="work__stack">
        <span class="visually-hidden">Built with: </span>
        {item.stack.join(", ")}
      </p>
    </Panel>
  ))}
</div>

<div class="shared">
  <h3 class="shared__title">Shared on GitHub</h3>
  <ul>
    {sharedRepos.map((repo) => (
      <li>
        <a href={repo.href} rel="me noopener" target="_blank">
          {repo.name}
        </a>
        <span class="shared__desc">{repo.description}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .work {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .work {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work :global(.work__panel--wide) {
      grid-column: 1 / -1;
    }
  }

  .work__title {
    font-size: var(--text-xl);
  }

  .work__summary {
    margin-top: 0.75rem;
  }

  .work__outcome {
    margin-top: 0.75rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--color-hanko);
  }

  .work__stack {
    margin-top: 1rem;
    color: var(--color-ash);
    font-size: var(--text-sm);
  }

  .shared {
    margin-top: 2.5rem;
  }

  .shared__title {
    font-size: var(--text-lg);
  }

  .shared ul {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .shared li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    align-items: baseline;
  }

  .shared a {
    font-weight: 700;
  }

  .shared__desc {
    color: var(--color-ash);
  }
</style>
