---
// The hero's right pane (spec §4.4): Marcus's stack as a network, laid out at build time from a
// fixed seed. At rest: steel dots, iron edges, labels hidden. scripts/stack-network.ts lights the
// node nearest the cursor by toggling .is-source / .is-lit / .is-echo; each element's ember twin
// cross-fades by opacity. It also moves a lit label to whichever side of its dot is clear of the
// portrait (.is-unlabelled when neither is). Decorative (aria-hidden).
import { NETWORK } from "../../data/network";
import { layoutNetwork } from "../../scripts/network";

const { nodes, edges } = layoutNetwork(NETWORK);
const at = (id: number) => nodes[id]!;
// Until the script places it: the side away from the middle, where the portrait sits.
const rightHalf = (x: number) => x > NETWORK.width / 2;
---

<svg
  class="net"
  viewBox={`0 0 ${NETWORK.width} ${NETWORK.height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  data-network
>
  <g>
    {edges.map(([a, b]) => (
      <g class="net__edge" data-net-edge={`${a}-${b}`}>
        <line
          class="net__base"
          x1={at(a).x}
          y1={at(a).y}
          x2={at(b).x}
          y2={at(b).y}
          vector-effect="non-scaling-stroke"
        />
        <line
          class="net__lit"
          x1={at(a).x}
          y1={at(a).y}
          x2={at(b).x}
          y2={at(b).y}
          vector-effect="non-scaling-stroke"
        />
      </g>
    ))}
  </g>
  <g>
    {nodes.map((n) => (
      <g
        class:list={["net__node", { "net__node--labelled": Boolean(n.label) }]}
        data-net-node={n.id}
      >
        <circle class="net__base" cx={n.x} cy={n.y} r={n.label ? 3 : 2} />
        <circle class="net__lit" cx={n.x} cy={n.y} r={n.label ? 4.5 : 3} />
        {n.label && (
          <text
            class="net__label"
            x={rightHalf(n.x) ? n.x + 10 : n.x - 10}
            y={n.y}
            text-anchor={rightHalf(n.x) ? "start" : "end"}
          >
            {n.label}
          </text>
        )}
      </g>
    ))}
  </g>
</svg>

<style>
  .net {
    display: block;
    width: 100%;
    height: 100%;
  }

  line.net__base {
    stroke: var(--color-iron);
    stroke-width: 1;
  }

  circle.net__base {
    fill: var(--color-steel);
  }

  line.net__lit {
    stroke: var(--color-ember);
    stroke-width: 1;
  }

  circle.net__lit {
    fill: var(--color-ember);
  }

  /* Lighting is an opacity cross-fade of each element's ember twin: quick on, slow off. */
  .net__lit,
  .net__label {
    opacity: 0;
    transition: opacity 600ms ease-out;
  }

  .is-lit > .net__lit {
    opacity: 1;
    transition-duration: 150ms;
  }

  .is-echo > .net__lit {
    opacity: 0.45;
    transition-duration: 150ms;
  }

  /* 14px on screen at any size: the script sets --net-scale to the SVG's scale (user units to CSS
     px). Centred on the dot's height, so the script's fit check can use the dot as the middle. */
  .net__label {
    fill: var(--color-ash);
    font-family: var(--font-mono);
    font-size: calc(14px / var(--net-scale, 1));
    dominant-baseline: central;
  }

  .is-source:not(.is-unlabelled) > .net__label {
    opacity: 1;
    transition-duration: 150ms;
  }

  /* Stacked, the portrait covers nearly all of the pane: dots and edges only (spec §4.4). */
  @media (max-width: 59.99rem) {
    .net__label {
      display: none;
    }
  }
</style>
