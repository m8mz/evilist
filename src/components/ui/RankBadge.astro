---
// Rank as a hanko (name seal). Ink gets denser as rank rises; S adds a gold inner ring
// (the mascot's gold). `stamp` plays the one-time stamp-in animation.
export type Rank = "E" | "E+" | "D" | "C" | "B" | "A" | "S";

interface Props {
  rank: Rank;
  size?: "sm" | "md" | "lg";
  stamp?: boolean;
  /** Fill the seal with night ink (use when it sits on top of an image). */
  backed?: boolean;
  label?: string;
  class?: string;
}

const {
  rank,
  size = "md",
  stamp = false,
  backed = false,
  label = `Rank ${rank}`,
  class: className,
} = Astro.props;
---

<span
  class:list={[
    "seal",
    `seal--${size}`,
    { "seal--stamp": stamp, "seal--backed": backed, "seal--s": rank === "S" },
    className,
  ]}
  data-rank={rank}
  role="img"
  aria-label={label}
>
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <g>
      <rect x="6" y="6" width="88" height="88" rx="14" class="seal__edge"></rect>
      {rank === "S" && <rect x="15" y="15" width="70" height="70" rx="8" class="seal__ring" />}
      <text x="50" y="52" class="seal__glyph" text-anchor="middle" dominant-baseline="central">
        {rank}
      </text>
    </g>
  </svg>
</span>

<style>
  .seal {
    display: inline-block;
    flex: none;
    transform: rotate(-6deg);
    opacity: var(--ink);
  }

  /* Ink density per rank (no inline styles: CSP forbids them). */
  .seal[data-rank="E"] {
    --ink: 0.45;
  }
  .seal[data-rank="E+"] {
    --ink: 0.52;
  }
  .seal[data-rank="D"] {
    --ink: 0.6;
  }
  .seal[data-rank="C"] {
    --ink: 0.7;
  }
  .seal[data-rank="B"] {
    --ink: 0.8;
  }
  .seal[data-rank="A"] {
    --ink: 0.9;
  }
  .seal[data-rank="S"] {
    --ink: 1;
  }

  .seal--sm {
    width: 2.25rem;
  }

  .seal--md {
    width: 3.5rem;
  }

  .seal--lg {
    width: clamp(5rem, 4rem + 4vw, 8rem);
  }

  .seal svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .seal__edge {
    fill: none;
    stroke: var(--color-hanko);
    stroke-width: 7;
  }

  .seal__ring {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 2.5;
  }

  .seal__glyph {
    fill: var(--color-hanko);
    font-family: var(--font-display);
    font-size: 46px;
  }

  .seal[data-rank="E+"] .seal__glyph {
    font-size: 34px;
  }

  /* Seal pressed onto a photo: back it with night ink so the glyph stays legible. */
  .seal--backed .seal__edge {
    fill: var(--color-night);
  }

  .seal--s .seal__glyph {
    font-size: 50px;
  }

  /* The page's one orchestrated moment: the seal is pressed onto the paper. */
  .seal--stamp {
    animation: stamp 520ms cubic-bezier(0.2, 0.9, 0.3, 1.2) 250ms both;
  }

  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-16deg) scale(1.7);
    }
    70% {
      opacity: var(--ink);
      transform: rotate(-5deg) scale(0.94);
    }
    to {
      opacity: var(--ink);
      transform: rotate(-6deg) scale(1);
    }
  }
</style>
