---
// Decorative `>` glyph texture: Axiom's "streaming data" background. Two identical strips drift
// left inside a track so the loop is seamless; global reduced-motion rules freeze it.
// Its box is exactly the area it covers; the parent must be `position: relative`.
interface Props {
  rows?: number;
  /** Arrows per row. One strip must be at least as wide as the area it fills, or a gap shows. */
  cols?: number;
  class?: string;
}

const { rows = 8, cols = 40, class: className } = Astro.props;
const strip = Array.from(
  { length: rows },
  (_, r) => `${" ".repeat(r % 4)}${"> ".repeat(cols).trimEnd()}`,
).join("\n");
---

<div class:list={["arrows", className]} aria-hidden="true">
  <div class="arrows__skew">
    <div class="arrows__track">
      <pre class="arrows__strip">{strip}</pre>
      <pre class="arrows__strip">{strip}</pre>
    </div>
  </div>
</div>

<style>
  .arrows {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    color: var(--color-slate);
    font-size: var(--text-caption);
    line-height: 1.6;
  }

  /* Skewed inside the clip box, so the component's own box is exactly the area it covers. */
  .arrows__skew {
    transform: skewY(-8deg);
  }

  .arrows__track {
    display: flex;
    width: max-content;
    animation: drift 40s linear infinite;
  }

  .arrows__strip {
    margin: 0;
    font: inherit;
    white-space: pre;
  }

  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }
</style>
