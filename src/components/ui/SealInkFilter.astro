---
// Shared SVG filter for RankBadge: a rough ink edge so seals read as stamped, not drawn.
// Rendered once per page by BaseLayout.
---

<svg width="0" height="0" aria-hidden="true" focusable="false" class="seal-defs">
  <filter id="seal-ink" x="-10%" y="-10%" width="120%" height="120%">
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.9"
      numOctaves="2"
      seed="7"
      result="noise"
    ></feTurbulence>
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5"></feDisplacementMap>
  </filter>
</svg>

<style>
  .seal-defs {
    position: absolute;
  }
</style>
