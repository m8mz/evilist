---
import { render } from "astro:content";
import NoteLayout from "../../layouts/NoteLayout.astro";
import { getPublishedNotes, type Note } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note, i) => ({
    params: { id: note.id },
    // Newest first, so the previous array item is the newer note.
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}

interface Props {
  note: Note;
  newer?: Note;
  older?: Note;
}

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
---

<NoteLayout note={note} newer={newer} older={older}>
  <Content />
</NoteLayout>
