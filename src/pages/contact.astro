---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Marcus Hancock-Gaillard about roles or infrastructure work."
>
  <section class="contact-form">
    <h2 class="text-4xl">Contact Me</h2>

    <!-- Tab Navigation -->
    <div class="tab-navigation">
      <button class="tab-btn active" data-type="personal">
        💬 Personal
      </button>
      <button class="tab-btn" data-type="business">
        💼 Business
      </button>
    </div>

    <form id="personal-form" class="form-section">
      <input type="text" name="name" placeholder="Your Name" required />
      <input type="email" name="email" placeholder="Your Email" required />
      <textarea name="message" placeholder="Your Message" required></textarea>
      <button type="submit">Send Personal Inquiry</button>
    </form>

    <form id="business-form" class="form-section">
      <input type="text" name="name" placeholder="Your Name" required />
      <input type="email" name="email" placeholder="Your Email" required />
      <input type="text" name="company" placeholder="Company Name" required />
      <input type="number" name="budget" placeholder="Project Budget (USD)" required />
      <textarea name="details" placeholder="Project Details" required></textarea>
      <button type="submit">Send Business Inquiry</button>
    </form>
  </section>
</BaseLayout>

<script>
  const tabBtns = document.querySelectorAll<HTMLElement>(".tab-btn");
  const sections = document.querySelectorAll(".form-section");

  function switchTab(targetType: string | undefined) {
    // Update tab buttons
    tabBtns.forEach((btn) => {
      btn.classList.remove("active");
      if (btn.dataset.type === targetType) {
        btn.classList.add("active");
      }
    });

    // Update form sections
    sections.forEach((sec) => {
      sec.classList.toggle("active", sec.id === targetType + "-form");
    });
  }

  // Add click listeners to tabs
  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      switchTab(btn.dataset.type);
    });
  });

  // Set default to personal
  switchTab("personal");
</script>

<style>
  .contact-form {
    max-width: 600px;
    margin: 0 auto;
    padding: 1rem;
  }
  .contact-form h2 {
    text-align: center;
    margin-bottom: 1rem;
  }
  .tab-navigation {
    display: flex;
    justify-content: center;
    border-bottom: 2px solid #e0e0e0;
    margin-bottom: 2rem;
  }

  .tab-btn {
    width: 50%;
    background: none;
    border: none;
    padding: 1rem 1.5rem;
    font-size: 1.5rem;
    font-weight: 500;
    color: #666;
    cursor: pointer;
    position: relative;
    transition: color 0.3s ease;
  }

  .tab-btn:hover {
    color: #007acc;
  }

  .tab-btn.active {
    color: #007acc;
  }

  .tab-btn.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: #007acc;
  }
  .form-section {
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .form-section.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
    animation: fadeIn 0.5s ease-out;
  }
  .form-section input,
  .form-section textarea {
    width: 100%;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition:
      border 0.3s,
      box-shadow 0.3s;
  }
  .form-section input:focus,
  .form-section textarea:focus {
    border-color: #007acc;
    box-shadow: 0 0 5px rgba(0, 122, 204, 0.5);
    outline: none;
  }
  .form-section button {
    display: block;
    width: 100%;
    padding: 0.75rem;
    border: none;
    border-radius: 4px;
    background: #007acc;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.3s;
  }
  .form-section button:hover {
    background: #005fa3;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
