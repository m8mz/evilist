---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import RankBadge from "../components/ui/RankBadge.astro";
import SpeedLines from "../components/ui/SpeedLines.astro";
import authorPic from "../images/author-pic.webp";
import { site } from "../data/site";
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <SpeedLines class="hero__lines" />
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__role">
          {site.role} in {site.location}
        </p>
        <h1 id="hero-title" class="hero__name">
          {site.name}
        </h1>
        <p class="hero__pitch">{site.pitch}</p>
        <div class="hero__actions">
          <Button href="#journey">See the ten-year journey</Button>
          <Button href="/resume" variant="ghost">
            Read the resume
          </Button>
        </div>
      </div>

      <figure class="hero__portrait">
        <Image
          src={authorPic}
          alt={`Portrait of ${site.name}`}
          widths={[320, 480, 720]}
          sizes="(min-width: 60rem) 26rem, 70vw"
          loading="eager"
          fetchpriority="high"
          class="hero__photo"
        />
        <RankBadge
          rank="S"
          size="lg"
          stamp
          backed
          label="S-rank: Sr. Systems Architect"
          class="hero__seal"
        />
      </figure>
    </div>
  </section>

  <!-- Placeholder bands: real content arrives in Phase 3 (data + sections) and Phase 4 (journey). -->
  <Section tone="slate" cut id="journey" aria-labelledby="journey-title">
    <h2 id="journey-title">From E-rank to S-rank</h2>
    <p class="placeholder">
      Scroll-driven journey from T1 tech support (2016) to Sr. Systems Architect: Phase 4.
    </p>
    <ol class="rank-row" aria-label="Rank progression">
      {(["E", "E+", "D", "C", "B", "A", "S"] as const).map((rank) => (
        <li>
          <RankBadge rank={rank} size="sm" />
        </li>
      ))}
    </ol>
  </Section>

  <Section id="skills" aria-labelledby="skills-title">
    <h2 id="skills-title">What I run</h2>
    <p class="placeholder">Skills grouped by domain: Phase 3.</p>
  </Section>

  <Section id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">What I build</h2>
    <p class="placeholder">Featured GitHub projects: Phase 3.</p>
  </Section>

  <Section tone="slate" id="about" aria-labelledby="about-title">
    <h2 id="about-title">How I work</h2>
    <p class="placeholder">About and contact prompt: Phase 3.</p>
  </Section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 6vw, 7.5rem) calc(var(--section-y) + var(--cut));
  }

  .hero :global(.hero__lines) {
    left: auto;
    width: min(70rem, 120%);
    right: -20%;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }

  .hero__role {
    color: var(--color-ash);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero__name {
    font-size: var(--text-hero);
    line-height: 1.02;
    max-width: 12ch;
  }

  .hero__pitch {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    max-width: 34rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }

  .hero__portrait {
    position: relative;
    justify-self: center;
    width: min(26rem, 78vw);
  }

  .hero :global(.hero__photo) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid var(--color-seam);
    filter: saturate(0.9) contrast(1.05);
  }

  .hero :global(.hero__seal) {
    position: absolute;
    right: -1.25rem;
    bottom: -1.75rem;
  }

  .placeholder {
    margin-top: 1rem;
    color: var(--color-ash);
  }

  .rank-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }
</style>
