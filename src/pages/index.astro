---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Hero from "../components/home/Hero.astro";
import Journey from "../components/journey/Journey.astro";
import Skills from "../components/home/Skills.astro";
import Work from "../components/home/Work.astro";
import ParallaxBand from "../components/home/ParallaxBand.astro";
import About from "../components/home/About.astro";
import OffTheClock from "../components/home/OffTheClock.astro";
import CTA from "../components/home/CTA.astro";
import { capitalise, decadePhrase, yearsOfExperience } from "../data/career";

const years = yearsOfExperience();
const decade = capitalise(decadePhrase(years));
---

<BaseLayout>
  <Hero />

  <Section tone="void" prompt="journey" id="journey" aria-labelledby="journey-title">
    <h2 id="journey-title">From E-rank to S+ rank</h2>
    <p class="lede">
      {decade}, seven ranks: from answering support calls to architecting two datacenters. Scroll,
      or pick a rank.
    </p>
    <Journey slot="bleed" />
  </Section>

  <Section prompt="stack" id="skills" aria-labelledby="skills-title">
    <h2 id="skills-title">What I run</h2>
    <p class="lede">The stack I operate and automate every day.</p>
    <Skills />
  </Section>

  <Section tone="carbon" prompt="built" id="work" aria-labelledby="work-title">
    <h2 id="work-title">What I build</h2>
    <p class="lede">Tools I've built to make infrastructure boring, in the good way.</p>
    <Work />
  </Section>

  <ParallaxBand />

  <Section prompt="how-i-work" id="about" aria-labelledby="about-title">
    <h2 id="about-title">How I work</h2>
    <About />
  </Section>

  <Section tone="carbon" prompt="off-the-clock" id="off-the-clock" aria-labelledby="otc-title">
    <h2 id="otc-title">Off the clock</h2>
    <p class="lede">The rig, the games and the anime. And lifting, for my health.</p>
    <OffTheClock />
  </Section>

  <Section prompt="contact" id="contact" aria-labelledby="cta-title">
    <CTA />
  </Section>
</BaseLayout>

<style>
  .lede {
    margin-top: 0.75rem;
    color: var(--color-ash);
    font-size: var(--text-heading-sm);
  }
</style>
