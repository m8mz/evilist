---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Hero from "../components/home/Hero.astro";
import JourneyTimeline from "../components/journey/JourneyTimeline.astro";
import Skills from "../components/home/Skills.astro";
import Work from "../components/home/Work.astro";
import About from "../components/home/About.astro";
import CTA from "../components/home/CTA.astro";
import { yearsOfExperience } from "../data/career";

const years = yearsOfExperience();
---

<BaseLayout>
  <Hero />

  <Section tone="slate" cut id="journey" aria-labelledby="journey-title">
    <h2 id="journey-title">From E-rank to S-rank</h2>
    <p class="lede">
      {years} years, seven ranks: from answering support calls to architecting two datacenters.
    </p>
    <JourneyTimeline />
  </Section>

  <Section id="skills" aria-labelledby="skills-title">
    <h2 id="skills-title">What I run</h2>
    <p class="lede">The stack I operate and automate every day.</p>
    <Skills />
  </Section>

  <Section tone="slate" id="work" aria-labelledby="work-title">
    <h2 id="work-title">What I build</h2>
    <p class="lede">Tools I've built to make infrastructure boring, in the good way.</p>
    <Work />
  </Section>

  <Section id="about" aria-labelledby="about-title">
    <h2 id="about-title">How I work</h2>
    <About />
  </Section>

  <Section tone="slate" cut id="contact" aria-labelledby="cta-title">
    <CTA />
  </Section>
</BaseLayout>

<style>
  .lede {
    margin-top: 0.75rem;
    color: var(--color-ash);
    font-size: var(--text-lg);
  }
</style>
