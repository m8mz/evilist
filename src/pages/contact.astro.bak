---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Contact Page";
import { actions } from "astro:actions";
---

<style>
  form > * {
    border: 3px solid black;
    margin: 0.5rem 0;
    border-radius: 10px;
    padding: 5px;
  }
</style>

<BaseLayout pageTitle={pageTitle}>
  <h2>contact</h2>
  <form
    class="flex flex-col items-center"
    method="post"
    action={actions.sendEmail}
  >
    <input name="name" required />
    <textarea class="w-[300px] rounded-lg" name="message" required></textarea>
    <button class="w-[125px]" type="submit">Send</button>
  </form>
</BaseLayout>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  const form = document.querySelector("form");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const { data, error } = await actions.sendEmail(formData);
    if (!error) navigate("/confirmation");
  });
</script>
