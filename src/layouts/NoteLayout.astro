---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, type Note } from "../lib/notes";
import { readingTime } from "../lib/readingTime";

interface Props {
  note: Note;
  newer?: Note;
  older?: Note;
}

const { note, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate } = note.data;
---

<BaseLayout title={title} description={description}>
  <article class="wrap note">
    <header class="note__head">
      <p class="note__back">
        <a href="/notes">All notes</a>
      </p>
      <h1>{title}</h1>
      <p class="note__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>,{" "}
        {readingTime(note.body ?? "")}
        {updatedDate && (
          <>
            . Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </>
        )}
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    {(newer || older) && (
      <nav class="note__pager" aria-label="More notes">
        {older && (
          <a href={`/notes/${older.id}/`} rel="prev">
            <span>Older</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a href={`/notes/${newer.id}/`} rel="next" class="note__pager-next">
            <span>Newer</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .note {
    padding-block: var(--section-y);
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }

  .note__back a {
    color: var(--color-ash);
    font-weight: 700;
  }

  .note__head h1 {
    margin-top: 1rem;
    font-size: var(--text-3xl);
  }

  .note__meta {
    margin-top: 0.75rem;
    color: var(--color-ash);
    font-size: var(--text-sm);
  }

  .prose {
    margin-top: 2.5rem;
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .prose :global(> * + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 2em;
    font-size: var(--text-2xl);
  }

  .prose :global(h3) {
    margin-top: 1.6em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }

  .prose :global(blockquote) {
    padding-left: 1em;
    border-left: 3px solid var(--color-hanko);
    color: var(--color-ash);
  }

  .prose :global(code) {
    font-size: 0.9em;
    padding: 0.1em 0.3em;
    background: var(--color-carbon);
  }

  .prose :global(pre) {
    padding: 1rem;
    overflow-x: auto;
    background: var(--color-carbon);
    border: 1px solid var(--color-seam);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .note__pager {
    display: grid;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-seam);
  }

  @media (min-width: 40rem) {
    .note__pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .note__pager a {
    display: grid;
    gap: 0.2rem;
    font-weight: 700;
    text-decoration: none;
  }

  .note__pager span {
    color: var(--color-ash);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .note__pager-next {
    text-align: right;
    grid-column: 2;
  }
</style>
